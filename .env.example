# ============================================================================
# Smart TV Launcher — Environment Configuration (.env.example)
# Copy this file to .env and adjust values as needed:
#   Copy-Item .env.example .env
# ============================================================================

# Port for the TV UI, iPhone Remote UI, and WebSocket server
PORT=3000

# Network binding:
# - Set ALLOW_LAN=true (or HOST=0.0.0.0) to allow iPhone Safari on the same Wi-Fi/LAN to connect.
# - Leave ALLOW_LAN=false (default in code if omitted) to bind only to 127.0.0.1 (localhost).
ALLOW_LAN=true
HOST=0.0.0.0

# Official YouTube Data API v3 Key (Server-side only — never exposed to frontend)
# If left empty, the app automatically falls back to opening YouTube search results
# directly on the TV browser, and still supports pasting direct YouTube video links/IDs!
YOUTUBE_API_KEY=

# Optional custom streaming shortcuts in JSON array format:
# Example: [{"id":"blutv","name":"BluTV","url":"https://www.blutv.com","category":"platform","color":"#0066ff","subtitle":"Yerli Platform"}]
CUSTOM_SHORTCUTS_JSON=

# Public/unlisted YouTube playlist shown as 'Sonra Izle' in the remote (needs YOUTUBE_API_KEY)
YOUTUBE_PLAYLIST_ID=

# Optional security token for series progress tracking & Chrome extension API:
# If set, calls to /api/progress must supply this token in X-Progress-Token or Authorization header.
PROGRESS_TOKEN=

# Optional: Launch Google Antigravity alongside TV interface when starting desktop apps (default: false)
# LAUNCH_ANTIGRAVITY=false

# Optional: Automatically open / focus TV Chrome when opening /remote on phone (default: false)
# When false (recommended), opening remote won't steal focus from what you're watching.
# You can always open/focus TV by clicking the 🖥️ button on the remote anytime!
AUTO_LAUNCH_TV=false

