{
  "manifest_version": 3,
  "name": "Smart TV Dizi Takipçisi",
  "version": "1.3.0",
  "description": "Dizi bölümlerini otomatik algılar, oynatıcı önü reklamları otomatik geçer, tv-controller sunucusuna kaydeder ve 'dizi' yer imleri klasörünü senkronize tutar.",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dizigom1.co/*",
        "*://*.selcukflix.com/*",
        "*://*.dizipal906.com/*",
        "*://*.yabancidizi.io/*",
        "*://*.hdfilmcehennemi.nl/*",
        "*://*.filmmakinesi.to/*",
        "*://*.dizibox.live/*",
        "*://*.dizilla.now/*",
        "*://*.dizilla.la/*",
        "*://*.diziyou.one/*",
        "*://tv.apple.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://tv.apple.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*",
        "*://*.gain.tv/*"
      ],
      "exclude_globs": [
        "http://192.168.*/*",
        "http://10.*/*"
      ],
      "js": ["adSkipper.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart TV Dizi Takip",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
