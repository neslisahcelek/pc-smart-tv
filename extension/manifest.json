{
  "manifest_version": 3,
  "name": "Smart TV Dizi Takipçisi",
  "version": "1.1.0",
  "description": "Dizi bölümlerini otomatik algılar, tv-controller sunucusuna kaydeder ve 'dizi' yer imleri klasörünü senkronize tutar.",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://192.168.*/*",
    "http://10.*/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dizigom1.co/*",
        "*://*.selcukflix.com/*",
        "*://*.dizipal906.com/*",
        "*://*.yabancidizi.io/*",
        "*://*.hdfilmcehennemi.nl/*",
        "*://*.filmmakinesi.to/*",
        "*://*.dizibox.live/*",
        "*://*.dizilla.now/*",
        "*://tv.apple.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart TV Dizi Takip",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
